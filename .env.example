# ==============================================================================
# HUMANTEK CREATOR CREDIT STUDIO - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# When deploying to Hostinger (hPanel Node.js Selector or VPS), configure these
# variables in the hPanel Environment Settings or in a secure server-side .env file.
# NEVER commit production credentials to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & URL
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Canonical public URL of your application (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://studio.humantek.art
NEXT_PUBLIC_APP_URL=https://studio.humantek.art

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE & REALTIME)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Critical: Keep strictly secret! Used for server-side balance updates, order fulfillment, and admin actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of superadmin emails automatically authorized for /management
ADMIN_EMAILS=huzaifafurqan22@gmail.com,admin@humantek.art

# ------------------------------------------------------------------------------
# 4. PAYPAL CHECKOUT (LIVE)
# ------------------------------------------------------------------------------
# The live Client ID, Merchant ID and API URL are set in src/lib/paypal-config.ts.
# Private Secret used by the server to capture payments and verify webhooks.
# Optional: with only the Client ID, checkout runs client-side (PayPal JS SDK creates and
# captures the order) and paid briefs are registered for review so you can verify them in PayPal.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook ID generated in PayPal Developer Dashboard for verification of webhook events
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ------------------------------------------------------------------------------
# 5. MANUAL PAYMENT GATEWAY (BANK TRANSFER & PAYONEER)
# ------------------------------------------------------------------------------
# Information shown to clients selecting manual offline payment at checkout
MANUAL_PAYMENT_BANK_NAME="Meezan Bank / International Commercial Bank"
MANUAL_PAYMENT_ACCOUNT_TITLE="Humantek Creative Studio"
MANUAL_PAYMENT_IBAN="PK36MEZN0000000000000000"
MANUAL_PAYMENT_SWIFT="MEZNPKKA"
MANUAL_PAYMENT_PAYONEER_EMAIL="billing@humantek.art"

# ------------------------------------------------------------------------------
# 5b. SCHEDULED JOBS
# ------------------------------------------------------------------------------
# Long random string. A daily Hostinger hPanel cron job calls:
#   curl -s -X POST -H "Authorization: Bearer <CRON_SECRET>" https://<domain>/api/cron/cleanup-references
# to delete reference images from wizard drafts abandoned for 24h+.
CRON_SECRET=generate-a-long-random-string

# ------------------------------------------------------------------------------
# 6. DEVELOPMENT FLAGS (DO NOT ENABLE IN PRODUCTION)
# ------------------------------------------------------------------------------
DEV_AUTO_CONFIRM=false

# Studio email delivery over SMTP (Hostinger Email)
# Port 465 uses SSL; set SMTP_PORT=587 for STARTTLS. Without these, emails are only logged.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@humantek.art
SMTP_PASS=
EMAIL_FROM="Humantek Creator Credit Studio <no-reply@humantek.art>"
EMAIL_REPLY_TO=
